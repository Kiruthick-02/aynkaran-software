{
  "appId": "com.aynkaran.insurance",
  "productName": "Aynkaran Insurance Management System",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "frontend/dist/**/*",
    "package.json",
    "package-lock.json",
    "node_modules/**/*"
  ],
  "asar": true,
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "sign": false,
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Aynkaran Insurance Management System",
    "artifactName": "Aynkaran Insurance Management System Setup ${version}.exe"
  },
  "mac": {
    "category": "public.app-category.business",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Office"
  }
}
